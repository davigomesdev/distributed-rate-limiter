# HTTP server bind address
BIND_ADDR=0.0.0.0:8080

# Shared Redis used by all instances
REDIS_URL=redis://127.0.0.1:6379

# Algorithm: token_bucket | sliding_window
ALGORITHM=token_bucket

# Token Bucket
TB_CAPACITY=100
TB_REFILL_PER_SEC=10

# Sliding Window
SW_LIMIT=100
SW_WINDOW_MS=60000

# If true, allow the request when Redis is unavailable (fail-open)
FAIL_OPEN=true

RUST_LOG=info